{
  "manifest_version": 3,
  "name": "Media Sleep Timer",
  "version": "1.0.0",
  "description": "Tự động hẹn giờ và dừng phát media trên YouTube, YouTube Music, SoundCloud và Spotify Web Player.",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://soundcloud.com/*",
    "https://open.spotify.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media Sleep Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
